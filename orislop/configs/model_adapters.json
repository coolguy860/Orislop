{
  "version": 1,
  "adapters": {
    "minilm": {
      "id": "minilm",
      "kind": "embedding",
      "enabled": false,
      "mode": "disabled",
      "modelPath": null,
      "notes": "Optional future local embedding adapter. No automatic downloads."
    },
    "openclip": {
      "id": "openclip",
      "kind": "openclip",
      "enabled": false,
      "mode": "disabled",
      "modelPath": null,
      "notes": "Optional future visual-template adapter. No automatic downloads."
    },
    "ocr": {
      "id": "ocr",
      "kind": "ocr",
      "enabled": false,
      "mode": "disabled",
      "notes": "Optional future OCR adapter."
    },
    "local_llm": {
      "id": "local_llm",
      "kind": "local_llm",
      "enabled": false,
      "mode": "disabled",
      "modelPath": null,
      "notes": "Optional future local claim-risk adapter. No remote calls."
    },
    "whisper": {
      "id": "whisper",
      "kind": "whisper",
      "enabled": false,
      "mode": "disabled",
      "modelPath": null,
      "notes": "Optional future local transcript adapter."
    },
    "existing_ai_detector": {
      "id": "existing_ai_detector",
      "kind": "existing_ai_detector",
      "enabled": false,
      "mode": "subprocess",
      "hfRepoId": null,
      "localModelDirectory": null,
      "scriptPath": null,
      "modelPath": null,
      "checkpointPath": null,
      "notes": "Optional wrapper for an existing Orislop AI detector. Disabled unless paths are configured."
    },
    "spatial_detector": {
      "id": "spatial_detector",
      "kind": "spatial_detector",
      "enabled": true,
      "mode": "localhost",
      "hfRepoId": "gonnerthetooner/orislop-fusion",
      "endpoint": "http://127.0.0.1:4317/v1/analyze",
      "localModelDirectory": null,
      "scriptPath": "core/spatial.py",
      "modelPath": null,
      "checkpointPath": null,
      "notes": "Required browser-extension spatial model. The localhost bridge downloads public weights once and keeps inference local."
    },
    "temporal_detector": {
      "id": "temporal_detector",
      "kind": "temporal_detector",
      "enabled": true,
      "mode": "promoted-package-shadow",
      "hfRepoId": null,
      "hfRevision": null,
      "hfSubdirectory": "final_model_package",
      "endpoint": "http://127.0.0.1:4317/v1/analyze",
      "localModelDirectoryEnvironment": "ORISLOP_TEMPORAL_PACKAGE_PATH",
      "hfRepoEnvironment": "ORISLOP_TEMPORAL_HF_REPO_ID",
      "hfRevisionEnvironment": "ORISLOP_TEMPORAL_HF_REVISION",
      "weightsSha256Environment": "ORISLOP_TEMPORAL_MODEL_SHA256",
      "detectorRoot": "core/temporal_detector",
      "scriptPath": "core/temporal_detector/temporal_deepfake_moe_hf_colab.py",
      "packageFiles": [
        "final_model.safetensors",
        "config.json",
        "metrics.json",
        "threshold.json",
        "artifact_manifest.json"
      ],
      "thresholdPath": "configs/detector_thresholds.json",
      "requiredFiles": [
        "temporal_deepfake_moe_hf_colab.py",
        "final_pipeline_core.py",
        "full_pipeline_utils.py"
      ],
      "notes": "Promoted 2026-08 temporal MoE package. It runs in local Heavy and Cloud Heavy, defaults to shadow, and may only tighten an existing automatic decision in corroborated mode."
    },
    "cloud_heavy_v1": {
      "id": "cloud_heavy_v1",
      "kind": "calibrated_spatial_motion_consensus",
      "enabled": true,
      "mode": "hybrid-cloud-shadow",
      "endpoint": "https://api.orislop.com/v2/analyze",
      "configPath": "configs/cloud_heavy_v1.json",
      "spatialFamily": [
        "gonnerthetooner/orislop-fusion",
        "prithivMLmods/Deepfake-Detection-Exp-02-21@adf169cf452ea42f80d8cdca1302c8c9d09d1725"
      ],
      "independentMotion": "MusapYildiz/aegis-video-detector@95b71346cec650165e6ad3fb20ed9e80f4b6702a:motion-only",
      "notes": "Two frame detectors form one spatial family. Automatic beta hide requires independent motion agreement and a signed calibration gate."
    },
    "av_joint_detector": {
      "id": "av_joint_detector",
      "kind": "audio_visual_joint",
      "enabled": false,
      "mode": "cloud-heavy-shadow",
      "hfRepoId": "gonnerthetooner/orislop-av-joint",
      "modelPathEnvironment": "ORISLOP_AV_JOINT_MODEL_PATH",
      "metadataPathEnvironment": "ORISLOP_AV_JOINT_METADATA_PATH",
      "yunetPathEnvironment": "ORISLOP_YUNET_MODEL_PATH",
      "temporalExpertSlot": "lip_sync",
      "maximumFaces": 4,
      "analysisWindowsSeconds": [2, 4, 8],
      "automaticSkipRequires": ["promoted phase-2 temporal+AV artifact", "independent spatial agreement"],
      "notes": "Phase 1/2 joint AV model. Disabled and shadow-only until corpus, evaluation, integrity, latency, and 10k-decision gates pass."
    },
    "spatial_aware_temporal_experiment": {
      "id": "spatial_aware_temporal_experiment",
      "kind": "experimental_fusion",
      "enabled": false,
      "mode": "shadow",
      "environmentFlag": "ORISLOP_EXPERIMENTAL_SPATIAL_TEMPORAL",
      "outputs": ["temporalAvProbability", "spatialProbability", "spatialAwareFusionProbability"],
      "independentVotes": ["temporalAvProbability", "spatialProbability"],
      "notes": "Phase 3 only. spatialAwareFusionProbability is diagnostic and is never counted as another independent spatial vote."
    },
    "fusion_detector": {
      "id": "fusion_detector",
      "kind": "fusion_detector",
      "enabled": false,
      "mode": "disabled",
      "hfRepoId": "gonnerthetooner/orislop-fusion",
      "localModelDirectory": null,
      "modelPath": null,
      "checkpointPath": null,
      "notes": "Optional future fusion model wrapper. Configure full Hugging Face repo ID locally; no automatic downloads."
    }
  }
}
