{
  "name": "orislop-browser-mvp",
  "version": "1.4.0",
  "private": true,
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=22.12 <25",
    "pnpm": "11.9.0"
  },
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "pnpm run web:build",
    "model:sync": "node scripts/syncAiClassifierArtifacts.mjs",
    "model:check": "node scripts/syncAiClassifierArtifacts.mjs --check",
    "typecheck": "node scripts/syncAiClassifierArtifacts.mjs --check && node scripts/runTsc.mjs --noEmit",
    "check": "node scripts/syncAiClassifierArtifacts.mjs --check && node scripts/runTsc.mjs --noEmit",
    "desktop:build": "node scripts/runTsc.mjs -p tsconfig.desktop.build.json && node scripts/copyDesktopAssets.mjs",
    "desktop:dev": "pnpm run desktop:build && electron build/apps/desktop/electron/main.js",
    "web:dev": "node scripts/serveWebStatic.mjs --dev",
    "web:build": "node scripts/buildWebStatic.mjs",
    "web:preview": "node scripts/serveWebStatic.mjs",
    "web:test": "node apps/web/tests/runWebChecks.mjs",
    "web:deploy:zip": "pnpm run web:build && node scripts/createNamecheapZip.mjs",
    "vercel:build": "pnpm run web:build",
    "extension:build": "node scripts/buildBrowserExtension.mjs",
    "extension:test": "node apps/extension/tests/runExtensionChecks.mjs",
    "extension:test:live": "node apps/extension/tests/runOllamaLiveCheck.mjs",
    "extension:test:youtube-live": "pnpm run extension:build && node apps/extension/tests/runYoutubeLiveScrollCheck.mjs",
    "extension:test:platforms-live": "pnpm run extension:build && node apps/extension/tests/runLivePlatformSmokeChecks.mjs",
    "extension:test:platforms": "node apps/extension/tests/runPlatformDomChecks.mjs",
    "vast:test:production": "python scripts/tests/test_vast_production_hardening.py -v && python apps/detector-bridge/tests/test_vast_supervisor.py -v && python scripts/verify-vast-production-package.py",
    "orislop:start": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/launchOrislop.ps1",
    "orislop:bootstrap": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/bootstrapOrislop.ps1",
    "orislop:launch-check": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/orislopLaunchCheck.ps1",
    "orislop:stop": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/stopOrislop.ps1",
    "orislop:doctor": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/orislopDoctor.ps1",
    "orislop:autostart:install": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/installOrislopAutostart.ps1",
    "orislop:autostart:remove": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/removeOrislopAutostart.ps1",
    "fact-check:setup": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/configureFactChecker.ps1",
    "extension-origin:setup": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/configureExtensionOrigin.ps1",
    "cloud:token": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/generateCloudToken.ps1",
    "cloud:check": "node scripts/checkCloudDeployment.mjs",
    "cloud:calibrate": ".\\.venv-detector\\Scripts\\python.exe scripts\\fit_cloud_heavy_calibration.py",
    "windows-companion:build": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/buildWindowsCompanion.ps1",
    "cloud:test:local": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/runCloudBridgeSmoke.ps1",
    "audit:feed-150": "node scripts/auditFeedCandidates.mjs --sample-size 150",
    "audit:cross-platform-128": "node scripts/auditCrossPlatformLaunchCorpus.mjs",
    "audit:youtube-1000": "node scripts/collectYoutubeScaleAudit.mjs",
    "extension:zip": "pnpm run extension:build && node scripts/createExtensionZip.mjs",
    "extension:test:package": "node scripts/verify-test-package.mjs",
    "extension:zip:cloud": "node scripts/buildBrowserExtension.mjs --cloud-beta && node scripts/createExtensionZip.mjs",
    "detector:setup": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/setupDetectorBridge.ps1",
    "detector:start": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/runDetectorBridge.ps1",
    "detector:test": "python apps/detector-bridge/tests/test_bridge_contract.py",
    "release:verify": "node scripts/verifyReleaseArtifacts.mjs",
    "production:check": "node scripts/runProductionReadinessChecks.mjs",
    "ai:train": "python scripts/train_ai_classifier_v1.py",
    "ai:evaluate": "python scripts/evaluate_ai_classifier_v1.py",
    "avsync:test": "python training/orislop_avsync/train_avsync.py self-test",
    "avsync:test:pipeline": "python training/orislop_avsync/tests/test_colab_pipeline.py",
    "dataset:self-test": "python training/orislop_dataset/build_dataset.py self-test",
    "dataset:test": "python training/orislop_dataset/tests/test_build_dataset.py",
    "dataset:test:full": ".\\.venv-detector\\Scripts\\python.exe -m unittest discover -s training/orislop_dataset/tests -p test_*.py -v",
    "dataset:rolling:self-test": "python training/orislop_dataset/rolling_pipeline.py self-test",
    "dataset:hf:self-test": "python training/orislop_dataset/hf_web_ingest.py self-test",
    "dataset:validate:seed": "python training/orislop_dataset/build_dataset.py validate --catalog training/orislop_dataset/catalogs/cross_platform_shadow_seed.jsonl",
    "temporal:colab:test": "python training/orislop_temporal_retrain/tests/test_cached_fusion_pipeline.py",
    "temporal:package:test": "python apps/detector-bridge/tests/test_temporal_package.py",
    "temporal:package:manifest": "python scripts/build_temporal_artifact_manifest.py",
    "test:ai-classifier": "node apps/web/tests/runAiClassifierChecks.mjs",
    "deep-scan:benchmark": "node scripts/benchmarkDeepScanPolicy.mjs",
    "test:adapters": "node packages/local-inference/tests/runAdapterChecks.mjs",
    "test:calibration": "node packages/slop-engine/tests/runCalibrationChecks.mjs",
    "test:claim-aware": "node packages/slop-engine/tests/runClaimAwareChecks.mjs",
    "test:desktop": "node apps/desktop/tests/runDesktopChecks.mjs",
    "test:fixtures": "node packages/slop-engine/tests/runFixtures.mjs",
    "test:lookahead": "node apps/desktop/tests/runLookaheadChecks.mjs",
    "test:skip": "node apps/desktop/tests/runSkipControllerChecks.mjs",
    "test:storage": "node packages/storage/tests/runStorageChecks.mjs",
    "test:youtube": "node apps/desktop/tests/runYoutubeExtractorChecks.mjs"
  },
  "devDependencies": {
    "electron": "^42.5.0",
    "typescript": "^6.0.3"
  }
}
