{
  "manifest_version": 3,
  "name": "Orislop Shield",
  "short_name": "Orislop",
  "version": "1.3.0",
  "description": "Clean up repetitive, synthetic, and low-value feed content while useful and uncertain posts stay visible.",
  "minimum_chrome_version": "114",
  "homepage_url": "https://orislop.com",
  "permissions": ["storage", "identity"],
  "host_permissions": [
    "https://www.youtube.com/*",
    "https://m.youtube.com/*",
    "https://www.instagram.com/*",
    "https://instagram.com/*",
    "https://www.tiktok.com/*",
    "https://tiktok.com/*",
    "https://www.linkedin.com/*",
    "https://linkedin.com/*",
    "https://api.orislop.com/*",
    "http://127.0.0.1:4317/*",
    "http://localhost:4317/*"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png",
    "256": "icons/icon256.png"
  },
  "action": {
    "default_title": "Orislop",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png",
      "256": "icons/icon256.png"
    }
  },
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*",
        "https://m.youtube.com/*",
        "https://www.instagram.com/*",
        "https://instagram.com/*",
        "https://www.tiktok.com/*",
        "https://tiktok.com/*",
        "https://www.linkedin.com/*",
        "https://linkedin.com/*"
      ],
      "js": [
        "slopPreferences.js",
        "productTelemetry.js",
        "aiClassifierModel.generated.js",
        "classifier.js",
        "platformAdapters.js",
        "controlCore.js",
        "contentScript.js"
      ],
      "css": ["contentStyles.css"],
      "run_at": "document_idle"
    }
  ]
}
