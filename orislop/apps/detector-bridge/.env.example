# Restrict production requests to the published extension origin.
ORISLOP_ALLOWED_EXTENSION_ORIGINS=chrome-extension://replace_with_32_character_extension_id
ORISLOP_ALLOWED_WEB_ORIGINS=https://orislop.com

# Local mode keeps the bridge on loopback. A TLS-terminating cloud container uses
# 0.0.0.0 and must also enable bearer authentication below.
ORISLOP_DETECTOR_HOST=127.0.0.1
ORISLOP_DETECTOR_PORT=4317
ORISLOP_ALLOW_ORIGINLESS_POSTS=0
ORISLOP_RATE_LIMIT_PER_MINUTE=120
ORISLOP_LIGHTWEIGHT_WORKERS=auto
ORISLOP_EXECUTION_MODE=auto
ORISLOP_AUTOTUNE_MODE=first-run
ORISLOP_AUTOTUNE_REPEATS=2
ORISLOP_AUTOTUNE_MAX_SECONDS=240
ORISLOP_AUTOTUNE_WARMUP=1
ORISLOP_AUTOTUNE_OUTPUT_TOLERANCE=0.002
ORISLOP_AUTOTUNE_RESET=0
ORISLOP_GPU_RESERVE_GIB=3.5
ORISLOP_GPU_RESERVE_FRACTION=0.12
ORISLOP_OOM_COOLDOWN_SECONDS=300
ORISLOP_RESULT_CACHE_TTL_SECONDS=21600
ORISLOP_REQUIRE_API_AUTH=0
ORISLOP_API_TOKENS=
ORISLOP_CLOUD_HEAVY_ENABLED=0
ORISLOP_GOOGLE_OAUTH_CLIENT_ID=
ORISLOP_TOKEN_SECRET=
ORISLOP_CONTENT_HMAC_SECRET=
DATABASE_URL=
ORISLOP_DIAGNOSTIC_BUCKET=
ORISLOP_S3_ENDPOINT=
ORISLOP_S3_REGION=auto
ORISLOP_S3_ACCESS_KEY_ID=
ORISLOP_S3_SECRET_ACCESS_KEY=
CLOUDFLARE_TUNNEL_TOKEN=
ORISLOP_CLOUD_HEAVY_ROLLOUT=shadow
ORISLOP_CLOUD_BETA_AUTOMATIC_HIDES=0
ORISLOP_OLLAMA_URL=http://127.0.0.1:11434
ORISLOP_OLLAMA_MODEL=qwen2.5:1.5b-instruct
ORISLOP_OLLAMA_KEEP_ALIVE=24h
# Leave empty for local Windows. Docker sets this to its private service name.
ORISLOP_TRUSTED_OLLAMA_HOST=
ORISLOP_TEXT_OLLAMA_TIMEOUT_SECONDS=90

# Promoted Temporal MoE. Set exactly one source. Local paths are appropriate for
# the Windows companion and mounted GPU pods. Hosted deployments should use a
# private HF model repo pinned to an immutable commit revision.
ORISLOP_TEMPORAL_ENABLED=1
ORISLOP_TEMPORAL_PACKAGE_PATH=/models/temporal/final_model_package
ORISLOP_TEMPORAL_HF_REPO_ID=
ORISLOP_TEMPORAL_HF_REVISION=
ORISLOP_TEMPORAL_HF_SUBDIR=final_model_package
ORISLOP_TEMPORAL_MODEL_SHA256=
ORISLOP_TEMPORAL_LEGACY_FALLBACK=0
# shadow reports the score without changing automatic decisions. corroborated
# may only make an existing Cloud Heavy decision stricter; it never creates an
# automatic skip by itself.
ORISLOP_TEMPORAL_ROLLOUT=corroborated

# Explain prefers platform captions. When they are missing or too short, the
# bridge can transcribe at most this many seconds after an explicit user click.
ORISLOP_TRANSCRIPTION_ENABLED=1
ORISLOP_TRANSCRIPTION_MODEL=tiny
ORISLOP_TRANSCRIPTION_DEVICE=cpu
ORISLOP_TRANSCRIPTION_COMPUTE_TYPE=int8
ORISLOP_TRANSCRIPTION_MAX_SECONDS=45
ORISLOP_TRANSCRIPTION_MIN_PLATFORM_CHARS=80

# Public/cloud deployments remain shadow-only until the model provenance and
# 10,000-decision rollout gates are signed off. Loopback development defaults
# to testing mode so a developer can exercise filtering locally.
ORISLOP_VISUAL_ROLLOUT_MODE=shadow
ORISLOP_PRELOAD_HEAVY_MODE=1

# This Vast/full-stack copy computes every detector and refuses readiness when
# any required artifact is missing. Automatic filtering is still controlled by
# the signed release gate; enabling inference does not forge that evidence.
ORISLOP_REQUIRE_FULL_MODEL_STACK=1
ORISLOP_AV_JOINT_ENABLED=1
ORISLOP_AV_JOINT_MODEL_PATH=/models/av/orislop_av_joint_v1.ts
ORISLOP_AV_JOINT_METADATA_PATH=/models/av/orislop_av_joint_v1.json
ORISLOP_YUNET_MODEL_PATH=/models/av/face_detection_yunet_2023mar.onnx
ORISLOP_YUNET_MODEL_SHA256=
ORISLOP_TEMPORAL_AV_FUSION_PATH=/models/temporal/stage2_temporal_av_fusion.pt
ORISLOP_TEMPORAL_AV_CALIBRATION_PATH=/models/temporal/stage3_temporal_av_calibration.pt

# Phase 3 research only. Its spatial-aware probability is never an independent
# vote alongside the same spatial model.
ORISLOP_EXPERIMENTAL_SPATIAL_TEMPORAL=0
ORISLOP_EXPERIMENTAL_SPATIAL_CHECKPOINT=

# Source-backed fact checking. Configure at least one provider, keep keys private,
# then restart the bridge. Use `pnpm fact-check:setup` for an interactive prompt.
BRAVE_SEARCH_API_KEY=
GOOGLE_FACT_CHECK_API_KEY=
ORISLOP_FACT_CHECK_CACHE_TTL_SECONDS=43200
ORISLOP_FACT_CHECK_AUTO_SKIP_CONFIDENCE=0.88
ORISLOP_FACT_CHECK_MIN_TRUSTED_SOURCES=2
ORISLOP_FACT_CHECK_OLLAMA_TIMEOUT_SECONDS=180

# Optional calibrated overrides.
# ORISLOP_LIGHTWEIGHT_THRESHOLD=0.94
# ORISLOP_SPATIAL_THRESHOLD=0.82
# ORISLOP_TEMPORAL_THRESHOLD=0.72
# ORISLOP_VISUAL_THRESHOLD=0.72
# ORISLOP_VISUAL_MIN_CORROBORATION=0.55
