# Copy values into Vast Account environment secrets or a private template.
# Never commit the completed file.

# Complete-stack v7: set the immutable commit printed by the Colab publisher.
# scripts/vast3090-complete-bootstrap.sh downloads it, verifies every file, and
# generates all model paths; do not duplicate those paths in this secret file.
ORISLOP_COMPLETE_STACK_REPO=gonnerthetooner/orislop-complete-stack-v1
ORISLOP_COMPLETE_STACK_REVISION=replace_with_full_40_character_commit

ORISLOP_API_TOKENS=replace_with_at_least_32_random_characters
ORISLOP_ALLOWED_EXTENSION_ORIGINS=chrome-extension://replace_with_32_character_extension_id
ORISLOP_ALLOWED_WEB_ORIGINS=https://orislop.com
ORISLOP_GOOGLE_OAUTH_CLIENT_ID=replace_with_google_oauth_client_id
ORISLOP_TOKEN_SECRET=replace_with_first_independent_32_byte_secret
ORISLOP_CONTENT_HMAC_SECRET=replace_with_second_independent_32_byte_secret

DATABASE_URL=postgresql://replace_with_managed_postgres_url
ORISLOP_DIAGNOSTIC_BUCKET=replace_with_private_seven_day_bucket
ORISLOP_S3_ENDPOINT=https://replace_with_s3_compatible_endpoint
ORISLOP_S3_REGION=auto
ORISLOP_S3_ACCESS_KEY_ID=replace_with_access_key
ORISLOP_S3_SECRET_ACCESS_KEY=replace_with_secret_key

# The recommended production path is a named Cloudflare tunnel whose ingress
# points to http://127.0.0.1:4317. Do not publish Vast's raw 4317 port.
ORISLOP_REQUIRE_CLOUDFLARE=1
CLOUDFLARE_TUNNEL_TOKEN=replace_with_cloudflare_tunnel_token

# The promoted temporal package is not embedded in this source bundle. Choose
# exactly one source. A local package may be uploaded under /models, or a
# private Hugging Face repo may be pinned to an immutable commit.
ORISLOP_TEMPORAL_ENABLED=1
ORISLOP_TEMPORAL_PACKAGE_PATH=/models/temporal/final_model_package
ORISLOP_TEMPORAL_HF_REPO_ID=
ORISLOP_TEMPORAL_HF_REVISION=
ORISLOP_TEMPORAL_HF_SUBDIR=final_model_package
ORISLOP_TEMPORAL_MODEL_SHA256=
HF_TOKEN=

# Full-stack mode refuses readiness unless every detector is genuinely loaded:
# lightweight, custom spatial, public frame, AEGIS motion, promoted temporal
# micro/mid/long/extra-long/fusion/calibration, and the real joint AV model.
ORISLOP_REQUIRE_FULL_MODEL_STACK=1
ORISLOP_AV_JOINT_ENABLED=1

# Option A: upload the complete AV release package to these local paths.
ORISLOP_AV_JOINT_MODEL_PATH=/models/av/orislop_av_joint_v1.ts
ORISLOP_AV_JOINT_METADATA_PATH=/models/av/orislop_av_joint_v1.json
ORISLOP_YUNET_MODEL_PATH=/models/av/face_detection_yunet_2023mar.onnx
ORISLOP_TEMPORAL_AV_FUSION_PATH=/models/temporal/stage2_temporal_av_fusion.pt
ORISLOP_TEMPORAL_AV_CALIBRATION_PATH=/models/temporal/stage3_temporal_av_calibration.pt
ORISLOP_YUNET_MODEL_SHA256=

# Option B: if any local file above is absent, download all five files from one
# pinned HF model repo. Set the exact filenames as they appear in that repo.
ORISLOP_AV_JOINT_HF_REPO_ID=gonnerthetooner/orislop-av-joint
ORISLOP_AV_JOINT_HF_REVISION=replace_with_full_40_character_commit
ORISLOP_AV_JOINT_HF_MODEL_FILE=av/orislop_av_joint_v1.ts
ORISLOP_AV_JOINT_HF_METADATA_FILE=av/orislop_av_joint_v1.json
ORISLOP_AV_JOINT_HF_YUNET_FILE=av/face_detection_yunet_2023mar.onnx
ORISLOP_AV_JOINT_HF_PHASE2_FUSION_FILE=temporal/stage2_temporal_av_fusion.pt
ORISLOP_AV_JOINT_HF_PHASE2_CALIBRATION_FILE=temporal/stage3_temporal_av_calibration.pt

# Safe RTX 3090 placement. Auto intentionally keeps Qwen on CPU on a 24 GB
# card, reserving GPU memory for the spatial and temporal ensemble.
ORISLOP_OLLAMA_MODEL=qwen2.5:1.5b-instruct
ORISLOP_OLLAMA_DEVICE=auto
ORISLOP_OLLAMA_KEEP_ALIVE=24h
ORISLOP_SPATIAL_AUX_DEVICE=cpu
ORISLOP_TRANSCRIPTION_DEVICE=cpu
ORISLOP_TRANSCRIPTION_COMPUTE_TYPE=int8
ORISLOP_LIGHTWEIGHT_WORKERS=auto
ORISLOP_EXECUTION_MODE=auto
ORISLOP_AUTOTUNE_MODE=first-run
ORISLOP_AUTOTUNE_REPEATS=2
ORISLOP_AUTOTUNE_MAX_SECONDS=240
ORISLOP_AUTOTUNE_WARMUP=1
ORISLOP_AUTOTUNE_OUTPUT_TOLERANCE=0.002
# Set this to 1 for one launch after changing drivers or wanting a fresh result.
ORISLOP_AUTOTUNE_RESET=0
ORISLOP_GPU_RESERVE_GIB=3.5
ORISLOP_GPU_RESERVE_FRACTION=0.12
ORISLOP_OOM_COOLDOWN_SECONDS=300
ORISLOP_PRELOAD_HEAVY_MODE=1
ORISLOP_STARTUP_TIMEOUT_SECONDS=1800

# Temporal is an actual corroborating vote. AV participates in its testing
# probability when artifact and input-quality checks pass; automatic actions
# remain protected by the signed AV release gate.
ORISLOP_TEMPORAL_ROLLOUT=corroborated
ORISLOP_CLOUD_HEAVY_ROLLOUT=shadow
ORISLOP_CLOUD_BETA_AUTOMATIC_HIDES=0
ORISLOP_VISUAL_ROLLOUT_MODE=shadow

BRAVE_SEARCH_API_KEY=
GOOGLE_FACT_CHECK_API_KEY=
