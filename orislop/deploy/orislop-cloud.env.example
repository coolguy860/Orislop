# Copy to a secret-managed deployment environment. Never commit real values.
ORISLOP_API_TOKENS=replace-with-long-random-bootstrap-token
ORISLOP_ALLOWED_EXTENSION_ORIGINS=chrome-extension://replace-with-final-extension-id
ORISLOP_GOOGLE_OAUTH_CLIENT_ID=replace.apps.googleusercontent.com
ORISLOP_TOKEN_SECRET=replace-with-at-least-32-random-bytes
ORISLOP_CONTENT_HMAC_SECRET=replace-with-a-different-random-secret
DATABASE_URL=postgresql://user:password@managed-postgres.example/orislop?sslmode=require

ORISLOP_DIAGNOSTIC_BUCKET=replace-with-seven-day-diagnostic-bucket
ORISLOP_S3_ENDPOINT=https://replace-with-private-s3-endpoint
ORISLOP_S3_REGION=auto
ORISLOP_S3_ACCESS_KEY_ID=replace
ORISLOP_S3_SECRET_ACCESS_KEY=replace
CLOUDFLARE_TUNNEL_TOKEN=replace

HF_TOKEN=replace-with-read-token-for-private-models
ORISLOP_TEMPORAL_HF_REPO_ID=owner/orislop-promoted-temporal
ORISLOP_TEMPORAL_HF_REVISION=replace-with-40-character-hugging-face-commit
ORISLOP_TEMPORAL_HF_SUBDIR=final_model_package
ORISLOP_TEMPORAL_MODEL_SHA256=replace-with-64-character-weights-sha256
ORISLOP_TEMPORAL_PACKAGE_PATH=
ORISLOP_TEMPORAL_ENABLED=1
ORISLOP_TEMPORAL_ROLLOUT=shadow

ORISLOP_OLLAMA_MODEL=qwen2.5:1.5b-instruct
ORISLOP_OLLAMA_KEEP_ALIVE=24h
ORISLOP_CLOUD_HEAVY_ROLLOUT=shadow
ORISLOP_CLOUD_BETA_AUTOMATIC_HIDES=0
